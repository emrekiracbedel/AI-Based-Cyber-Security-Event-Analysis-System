{
  "name": "mini-siem-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"cross-env DEV_SERVER_PORT=5173 vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development DEV_SERVER_PORT=5173 electron .\"",
    "dev:5174": "concurrently -k \"cross-env DEV_SERVER_PORT=5174 vite\" \"wait-on tcp:127.0.0.1:5174 && cross-env NODE_ENV=development DEV_SERVER_PORT=5174 electron .\"",
    "build": "vite build",
    "build:win": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir",
    "build:win:full": "node scripts/package-windows.cjs",
    "preview": "vite preview",
    "desktop": "cross-env NODE_ENV=production electron ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^41.1.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.14",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.minisiem.desktop",
    "productName": "Mini-SIEM Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "extraResources": [
      {
        "from": "../backend/dist/MiniSIEM-Backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
